<Window x:Class="NetSpeedWidget.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ağ İstatistikleri"
        Height="360" Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#F0181820"
            CornerRadius="12"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ağ Durumu ve İstatistikler" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" 
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Foreground="#94A3B8"
                        Background="#20FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Details Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Adapter -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="Aktif Bağdaştırıcı:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="TxtAdapter" Text="Wi-Fi" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- IP Address -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="Yerel IP Adresi:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="TxtIpAddress" Text="192.168.1.1" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Download -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓" Foreground="#22C55E" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="İndirme (Hız / Toplam):" Foreground="#94A3B8" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDownload" Text="0 KB/s | 0 MB" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Upload -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↑" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Yükleme (Hız / Toplam):" Foreground="#94A3B8" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtUpload" Text="0 KB/s | 0 MB" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Kapat" 
                        Click="Close_Click"
                        Width="90" Height="32"
                        Foreground="#FFFFFF"
                        Background="#334155"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
